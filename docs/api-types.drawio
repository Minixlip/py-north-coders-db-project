        </mxCell>
        <mxCell id="v47" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;GET /api/user/me/events&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="796" width="455" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v48" value="Signed in" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="501" y="796" width="151" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v49" value="—" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="652" y="796" width="276" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v50" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;200 { events: MyEvent[] }&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="928" y="796" width="506" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v51" value="&lt;b&gt;List shapes and ordering&lt;/b&gt;&lt;br&gt;Event browse and My Events lists are ordered by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;starts_at&lt;/span&gt;, then &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;id&lt;/span&gt;. My Events contains RSVP records joined to events. Its &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;id&lt;/span&gt; is the event ID, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;event_rank&lt;/span&gt; starts at 1, and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;total_rsvps&lt;/span&gt; repeats on each row. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;rsvp_date&lt;/span&gt; is the RSVP&amp;#x27;s &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;created_at&lt;/span&gt; and can be null under the database schema. An account with zero RSVPs gets &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;{ &amp;quot;events&amp;quot;: [] }&lt;/span&gt;. An event with zero attendees gets &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;{ &amp;quot;attendees&amp;quot;: [] }&lt;/span&gt;. Attendees are ordered by user ID." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="870" width="682" height="164" as="geometry" />
        </mxCell>
        <mxCell id="v52" value="&lt;b&gt;Event detail and venue fields&lt;/b&gt;&lt;br&gt;Create and update both return an event without venue name, address, or capacity. Fetch the detail endpoint for those fields. For an event without a venue, detail returns null for &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;venue_id&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;venue_name&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;venue_address&lt;/span&gt;, and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;venue_capacity&lt;/span&gt;. PATCH accepts explicit null for description or venue and treats omitted fields as unchanged." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="870" width="682" height="164" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
