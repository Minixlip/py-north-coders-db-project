        </mxCell>
        <mxCell id="v6" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;Protected requests send &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;Authorization: Bearer &amp;lt;access_token&amp;gt;&lt;/span&gt;. Registration returns a user, and login issues the token. Tokens expire after 30 minutes. The login JWT contains the user ID in &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;sub&lt;/span&gt; as a string and expiry in &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;exp&lt;/span&gt; as Unix seconds." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E3F7F2;strokeColor=#8CC9B9;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="179" width="1388" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Method and endpoint" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="283" width="455" height="45" as="geometry" />
        </mxCell>
