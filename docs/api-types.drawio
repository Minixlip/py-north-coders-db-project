        <mxCell id="v49" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;500&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="581" y="951" width="96" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v50" value="Plain text &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;Internal Server Error&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="677" y="951" width="757" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v51" value="Missing or invalid server signing configuration on login or token verification" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="1003" width="535" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v52" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;503&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="581" y="1003" width="96" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v53" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;Authentication is not configured.&amp;quot;&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="677" y="1003" width="757" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v54" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;TypeScript error shapes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;ValidationIssue&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;type:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;loc:&amp;nbsp;(string&amp;nbsp;|&amp;nbsp;number)[];&lt;br&gt;&amp;nbsp;&amp;nbsp;msg:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;input?:&amp;nbsp;unknown;&lt;br&gt;&amp;nbsp;&amp;nbsp;ctx?:&amp;nbsp;Record&amp;lt;string,&amp;nbsp;unknown&amp;gt;;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;JsonApiError&amp;nbsp;=&amp;nbsp;{&amp;nbsp;detail:&amp;nbsp;string&amp;nbsp;|&amp;nbsp;ValidationIssue[]&amp;nbsp;};&lt;br&gt;&lt;br&gt;//&amp;nbsp;Shape&amp;nbsp;passed&amp;nbsp;to&amp;nbsp;frontend&amp;nbsp;components&amp;nbsp;after&amp;nbsp;parsing&amp;nbsp;the&amp;nbsp;response.&lt;br&gt;type&amp;nbsp;ApiError&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;status:&amp;nbsp;number&amp;nbsp;|&amp;nbsp;null;&amp;nbsp;//&amp;nbsp;null&amp;nbsp;for&amp;nbsp;a&amp;nbsp;network&amp;nbsp;failure&lt;br&gt;&amp;nbsp;&amp;nbsp;message:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;issues?:&amp;nbsp;ValidationIssue[];&lt;br&gt;};&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="1091" width="682" height="368" as="geometry" />
        </mxCell>
        <mxCell id="v55" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;Login response for an empty JSON object&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;detail&amp;quot;:&amp;nbsp;[&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;&amp;quot;type&amp;quot;:&amp;nbsp;&amp;quot;missing&amp;quot;,&amp;nbsp;&amp;quot;loc&amp;quot;:&amp;nbsp;[&amp;quot;body&amp;quot;,&amp;nbsp;&amp;quot;email&amp;quot;],&amp;nbsp;&amp;quot;msg&amp;quot;:&amp;nbsp;&amp;quot;Field&amp;nbsp;required&amp;quot;,&amp;nbsp;&amp;quot;input&amp;quot;:&amp;nbsp;{}&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;&amp;quot;type&amp;quot;:&amp;nbsp;&amp;quot;missing&amp;quot;,&amp;nbsp;&amp;quot;loc&amp;quot;:&amp;nbsp;[&amp;quot;body&amp;quot;,&amp;nbsp;&amp;quot;password&amp;quot;],&amp;nbsp;&amp;quot;msg&amp;quot;:&amp;nbsp;&amp;quot;Field&amp;nbsp;required&amp;quot;,&amp;nbsp;&amp;quot;input&amp;quot;:&amp;nbsp;{}&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;]&lt;br&gt;}&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="1091" width="682" height="178" as="geometry" />
        </mxCell>
        <mxCell id="v56" value="&lt;b&gt;Parsing errors&lt;/b&gt;&lt;br&gt;Use &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;loc&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;msg&lt;/span&gt; for field feedback. Read the status before parsing the body so that empty &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;204&lt;/span&gt; responses succeed and non-JSON errors can show a generic message." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="1343" width="682" height="116" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-4" name="Frontend &amp; seeds">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" math="0" shadow="0" background="#F4F7FC" pageHeight="845">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2" value="NC PLUS ONE" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#365D8D;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="29" width="1388" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Frontend types and seed examples" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="58" width="1388" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Session and form values, plus seeded cases for reviewing the UI" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#435671;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="108" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D3DDEB;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="153" width="1388" height="2" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;Types derived from the API&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;Session&amp;nbsp;=&amp;nbsp;{&amp;nbsp;accessToken:&amp;nbsp;string;&amp;nbsp;userId:&amp;nbsp;number;&amp;nbsp;expiresAt:&amp;nbsp;number&amp;nbsp;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;EventFormValues&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;title:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;description:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;startsAtLocal:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;endsAtLocal:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;venueId:&amp;nbsp;string;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;RsvpStatus&amp;nbsp;=&amp;nbsp;&amp;quot;signed-out&amp;quot;&amp;nbsp;|&amp;nbsp;&amp;quot;loading&amp;quot;&amp;nbsp;|&amp;nbsp;&amp;quot;unavailable&amp;quot;&amp;nbsp;|&amp;nbsp;&amp;quot;going&amp;quot;&amp;nbsp;|&amp;nbsp;&amp;quot;not-going&amp;quot;;&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="182" width="1388" height="273" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Seed data to review against the UI" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="483" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="&lt;b&gt;Event with a full venue&lt;/b&gt;&lt;br&gt;Event 1, “Leeds Tech Meetup – June Edition”, has a venue name, address, and capacity and four attendees. The first seeded user organises it and has RSVPs to events 2, 3, 6, and 8." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="527" width="682" height="123" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="&lt;b&gt;Missing address and description&lt;/b&gt;&lt;br&gt;Event 2, “Intro to Machine Learning Workshop”, uses “Online – Zoom” with a null address. Event 9, “Freelancing as a Developer”, has a null description." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="527" width="682" height="123" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="&lt;b&gt;Longest seeded title&lt;/b&gt;&lt;br&gt;Event 7, “PostgreSQL for Application Developers”, has the longest seeded title at 37 characters. Check how titles wrap on narrow event cards." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="674" width="682" height="123" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="&lt;b&gt;Event without a venue&lt;/b&gt;&lt;br&gt;The seed assigns venues to all ten events. Clearing event 1&amp;#x27;s venue with &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;PATCH {&amp;quot;venue_id&amp;quot;: null}&lt;/span&gt; in the temporary database confirmed the null venue response above." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="674" width="682" height="123" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
