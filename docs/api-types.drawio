        </mxCell>
        <mxCell id="v6" value="Response keys remain present when their values are &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;null&lt;/span&gt;. Optional request fields may be omitted." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="179" width="1388" height="63" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;Authentication and dates&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;IsoDateTime&amp;nbsp;=&amp;nbsp;string;&amp;nbsp;//&amp;nbsp;ISO&amp;nbsp;8601&amp;nbsp;date-time&amp;nbsp;received&amp;nbsp;as&amp;nbsp;JSON&amp;nbsp;text&lt;br&gt;&lt;br&gt;type&amp;nbsp;LoginRequest&amp;nbsp;=&amp;nbsp;{&amp;nbsp;email:&amp;nbsp;string;&amp;nbsp;password:&amp;nbsp;string&amp;nbsp;};&lt;br&gt;type&amp;nbsp;LoginResponse&amp;nbsp;=&amp;nbsp;{&amp;nbsp;access_token:&amp;nbsp;string;&amp;nbsp;token_type:&amp;nbsp;&amp;quot;bearer&amp;quot;&amp;nbsp;};&lt;br&gt;type&amp;nbsp;RegisterRequest&amp;nbsp;=&amp;nbsp;{&amp;nbsp;name:&amp;nbsp;string;&amp;nbsp;email:&amp;nbsp;string;&amp;nbsp;password:&amp;nbsp;string&amp;nbsp;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;RegisteredUser&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;name:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;email:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;created_at:&amp;nbsp;IsoDateTime;&lt;br&gt;};&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="264" width="682" height="292" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;Public event data&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;EventSummary&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;title:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;description:&amp;nbsp;string&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;starts_at:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;ends_at:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;organiser_id:&amp;nbsp;number&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_id:&amp;nbsp;number&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;created_at:&amp;nbsp;IsoDateTime&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;EventDetail&amp;nbsp;=&amp;nbsp;EventSummary&amp;nbsp;&amp;amp;&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_name:&amp;nbsp;string&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_address:&amp;nbsp;string&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_capacity:&amp;nbsp;number&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;};&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="264" width="682" height="368" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;Create and update&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;CreateEventRequest&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;title:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;description:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;starts_at:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;ends_at:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_id:&amp;nbsp;number;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;CreatedEvent&amp;nbsp;=&amp;nbsp;CreateEventRequest&amp;nbsp;&amp;amp;&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;organiser_id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;created_at:&amp;nbsp;IsoDateTime;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;UpdateEventRequest&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;title?:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;description?:&amp;nbsp;string&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;starts_at?:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;ends_at?:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;venue_id?:&amp;nbsp;number&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;};&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="580" width="682" height="463" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="&lt;b style=&quot;font-family:Arial;color:#16263D;font-size:17px&quot;&gt;RSVPs and attendees&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:13px;line-height:19px&quot;&gt;type&amp;nbsp;Rsvp&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;attendee_id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;event_id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;created_at:&amp;nbsp;IsoDateTime;&lt;br&gt;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;Attendee&amp;nbsp;=&amp;nbsp;{&amp;nbsp;id:&amp;nbsp;number;&amp;nbsp;name:&amp;nbsp;string;&amp;nbsp;email:&amp;nbsp;string&amp;nbsp;};&lt;br&gt;&lt;br&gt;type&amp;nbsp;MyEvent&amp;nbsp;=&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;id:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;title:&amp;nbsp;string;&lt;br&gt;&amp;nbsp;&amp;nbsp;starts_at:&amp;nbsp;IsoDateTime;&lt;br&gt;&amp;nbsp;&amp;nbsp;rsvp_date:&amp;nbsp;IsoDateTime&amp;nbsp;|&amp;nbsp;null;&lt;br&gt;&amp;nbsp;&amp;nbsp;event_rank:&amp;nbsp;number;&lt;br&gt;&amp;nbsp;&amp;nbsp;total_rsvps:&amp;nbsp;number;&lt;br&gt;};&lt;br&gt;&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="656" width="682" height="387" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
