        <mxCell id="v33" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;mode: &amp;quot;create&amp;quot; | &amp;quot;edit&amp;quot;&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;initialValues: EventFormValues&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;onSubmit: (values: EventFormValues) =&amp;gt; void&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;pending: boolean&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;error: ApiError | null&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
