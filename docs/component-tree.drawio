        <mxCell id="v31" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;event: EventDetail&lt;/span&gt;, from the shared event detail query" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
