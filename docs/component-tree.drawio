        </mxCell>
        <mxCell id="v30" value="&lt;b&gt;Route outlet&lt;/b&gt;&lt;br&gt;The Browse events, Account pages, and Event management tabs attach to this outlet. Shared nodes appear in each branch that uses them." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="927" y="355" width="507" height="103" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="&lt;b&gt;Shared component props&lt;/b&gt;&lt;br&gt;The shell, providers, and guards are shared. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventForm&lt;/span&gt; is shared by Create and Edit. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventLink&lt;/span&gt; takes &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;eventId: number&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;title: string&lt;/span&gt;. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventTime&lt;/span&gt; takes &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;startsAt: IsoDateTime&lt;/span&gt; and optional &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;endsAt?: IsoDateTime&lt;/span&gt;. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;StatusMessage&lt;/span&gt; takes &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;kind: &amp;quot;loading&amp;quot; | &amp;quot;empty&amp;quot; | &amp;quot;error&amp;quot;&lt;/span&gt;, &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;message: string&lt;/span&gt;, and optional &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;onRetry?: () =&amp;gt; void&lt;/span&gt;. Each appears on multiple pages. The remaining cards, lists, rows, controls, and auth forms belong to the pages shown above." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="927" y="475" width="507" height="223" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;&lt;b&gt;Review pending.&lt;/b&gt; Have an instructor or peer review the four planning files before scaffolding the frontend or writing components. Update the tree and note the reason when a page, prop, or state owner changes during implementation." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1DE;strokeColor=#E5B985;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="927" y="715" width="507" height="143" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
