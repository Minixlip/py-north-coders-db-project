          <mxGeometry x="486" y="864" width="948" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v36" value="&lt;b&gt;Data and form ownership&lt;/b&gt;&lt;br&gt;The page submits the API mutation and handles navigation. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventForm&lt;/span&gt; owns the draft inputs. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;AttendeesPage&lt;/span&gt; mounts after the organiser check, so it starts fetching only after the check passes." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
