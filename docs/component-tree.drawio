          <mxGeometry x="486" y="817" width="948" height="52" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="&lt;b&gt;Data and form ownership&lt;/b&gt;&lt;br&gt;Each auth form owns its draft inputs. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;LoginPage&lt;/span&gt; hands valid login results to &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;AuthProvider&lt;/span&gt;. &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RegisterPage&lt;/span&gt; routes to sign-in after successful registration." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="888" width="1388" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
