<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="page-1" name="Session &amp; queries">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" math="0" shadow="0" background="#F4F7FC" pageHeight="820">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2" value="NC PLUS ONE" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#365D8D;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="29" width="1388" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="State map" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="58" width="1388" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Session, URL state, and the shared query cache for server data" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#435671;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="108" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D3DDEB;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="153" width="1388" height="2" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="State" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="187" width="296" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Owner" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="187" width="435" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Reason and lifecycle" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="187" width="657" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="Session token, user ID, and expiry" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="232" width="296" height="121" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;AuthProvider&lt;/span&gt; context, with the token restored from tab-scoped &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;sessionStorage&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="232" width="435" height="121" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="Navigation, guards, and authenticated requests use the same session. Read &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;sub&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;exp&lt;/span&gt; from the JWT for client-side routing and display. The API verifies the token and permissions. Clear the session on sign-out, expiry, or a protected request&amp;#x27;s &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;401&lt;/span&gt; for the current token. A failed login stays a form error." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="232" width="657" height="121" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="Event ID and intended return path" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="353" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="URL via the router" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="353" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="IDs support deep links. The optional &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;next&lt;/span&gt; parameter preserves a destination through sign-in and registration. Registration passes the prefilled email through navigation state for the next screen." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="353" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="Public events list" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="436" width="296" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;useEvents()&lt;/span&gt;, cache key &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;[&amp;quot;events&amp;quot;]&lt;/span&gt;, consumed by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventsPage&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="436" width="435" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="The server supplies the list and sort order. The page renders loading, failure, empty, and populated states from the query result." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="436" width="657" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="Public event detail" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="500" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;useEvent(eventId)&lt;/span&gt;, key &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;[&amp;quot;event&amp;quot;, eventId]&lt;/span&gt;, consumed by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventDetailsPage&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RequireOrganiser&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="500" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="The detail page, guard, and edit defaults share the same fetched record. Edit and Attendees receive the event from the guard." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="500" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="Signed-in user&amp;#x27;s RSVP events" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="583" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;useMyEvents()&lt;/span&gt;, key &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;[&amp;quot;my-events&amp;quot;, userId]&lt;/span&gt;, consumed by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;MyEventsPage&lt;/span&gt; and signed-in &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventDetailsPage&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="583" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="Both pages use the same server list. Enable the query only with a valid session. The page derives the RSVP total from the first row&amp;#x27;s &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;total_rsvps&lt;/span&gt;, or zero for an empty list." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="583" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="Attendees" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="666" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;useAttendees(eventId)&lt;/span&gt;, key &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;[&amp;quot;attendees&amp;quot;, userId, eventId]&lt;/span&gt;, consumed by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;AttendeesPage&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="666" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="The organiser guard runs before this query. Scope the cache to the signed-in account, and cancel and remove private queries on sign-out or account change to prevent stale responses from repopulating them." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="666" width="657" height="83" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="Local &amp; derived">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" math="0" shadow="0" background="#F4F7FC" pageHeight="835">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2" value="NC PLUS ONE" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#365D8D;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="29" width="1388" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Local and derived state" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="58" width="1388" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Component-owned inputs and values derived from session, API, or render data" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#435671;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="108" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D3DDEB;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="153" width="1388" height="2" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="State" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="187" width="296" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Owner" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="187" width="435" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Reason and lifecycle" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#173454;strokeColor=#173454;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="187" width="657" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="Organiser access" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="232" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="Derived by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventDetailsPage&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RequireOrganiser&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="232" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="Compare a valid session&amp;#x27;s user ID with the event&amp;#x27;s non-null &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;organiser_id&lt;/span&gt;. The detail page uses the result to show links. The guard uses it to render the organiser page." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="232" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="Current RSVP status" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="315" width="296" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="Derived by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventDetailsPage&lt;/span&gt; and passed to &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RsvpActions&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="315" width="435" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="Visitors are &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;signed-out&amp;quot;&lt;/span&gt;. For signed-in users, match &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;eventId&lt;/span&gt; to a row&amp;#x27;s &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;id&lt;/span&gt; to choose &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;going&amp;quot;&lt;/span&gt; or &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;not-going&amp;quot;&lt;/span&gt;. While the membership query is pending or failed, pass &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;loading&amp;quot;&lt;/span&gt; or &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;&amp;quot;unavailable&amp;quot;&lt;/span&gt; and keep RSVP controls disabled." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="315" width="657" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="Login and registration drafts and field validation" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="417" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="Local to controlled &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;LoginForm&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RegisterForm&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="417" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="Form fields only matter while those forms are mounted. Keep passwords in the form and request. Pages pass submission status and error down and handle success." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="417" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="Event draft and field validation" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="500" width="296" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="Local to controlled &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventForm&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="500" width="435" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="Create starts blank. Edit initializes from the event and resets when the ID changes. Background refetches preserve both the draft and its original defaults. The page compares them at submission to send only changed fields on edit." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="500" width="657" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="Mutation pending state and API errors" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="602" width="296" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="Hook local to the page initiating the action" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="602" width="435" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="The page passes pending and error props to its form or RSVP controls. Disable repeat submissions while a mutation is pending. Preserve form fields after an error so they can be corrected." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="602" width="657" height="83" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="Formatted dates and venue display" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="685" width="296" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="Derived during render by &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;EventTime&lt;/span&gt; and &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;VenueDetails&lt;/span&gt;" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="342" y="685" width="435" height="102" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="Parse ISO strings for display in the viewer&amp;#x27;s local time. For event forms, turn local date-time entries into ISO timestamps with an explicit offset or &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;Z&lt;/span&gt;. Display a fallback for a null venue and omit a missing address." style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EBF1FA;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="777" y="685" width="657" height="102" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-3" name="Updates &amp; forms">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" math="0" shadow="0" background="#F4F7FC" pageHeight="820">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2" value="NC PLUS ONE" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#365D8D;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="29" width="1388" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Cache updates and form rules" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="58" width="1388" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="What the frontend refreshes after an event or RSVP mutation" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#435671;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="108" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D3DDEB;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="153" width="1388" height="2" as="geometry" />
        </mxCell>
        <mxCell id="action-0" value="&lt;b&gt;Create event&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#9CB6E5;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="191" width="248" height="78" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Refresh the public list. Navigate to the returned event ID and fetch its full detail with venue fields." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="191" width="1079" height="78" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="action-0" target="v7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="action-1" value="&lt;b&gt;Edit event&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#9CB6E5;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="291" width="248" height="78" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="Refresh the public list, event detail, and any cached My Events list for the signed-in user. A title or time edit may change that list&amp;#x27;s display, order, and ranks." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="291" width="1079" height="78" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="action-1" target="v10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="action-2" value="&lt;b&gt;RSVP or cancel&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#9CB6E5;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="391" width="248" height="88" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="Refresh My Events and any cached attendee list for that event. Keep the RSVP controls pending until membership is refreshed. If a duplicate RSVP returns &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;409&lt;/span&gt; or cancellation returns an RSVP &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;404&lt;/span&gt;, reload membership and display the server message. Read a successful cancellation as &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;204&lt;/span&gt; with an empty body." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="391" width="1079" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="action-2" target="v13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="Form assumptions for review" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="519" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="&lt;b&gt;Venue IDs&lt;/b&gt;&lt;br&gt;Use a numeric venue ID input for now. The API requires an existing venue ID to create an event and has no venues endpoint. On edit, clearing the venue sends &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;venue_id: null&lt;/span&gt;. Confirm with the reviewer how users should discover venue IDs." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF1DE;strokeColor=#E5B985;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="566" width="682" height="146" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="&lt;b&gt;Field validation&lt;/b&gt;&lt;br&gt;Validate that the title is present, title and description fit the 255-character database fields, and the end time follows the start. An empty create description is sent as an empty string. An existing description cleared during edit is sent as &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;null&lt;/span&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="566" width="682" height="146" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>