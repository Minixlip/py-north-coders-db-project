    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" math="0" shadow="0" background="#F4F7FC" pageHeight="820">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2" value="NC PLUS ONE" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#365D8D;fontFamily=Arial;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="29" width="1388" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Navigation rules" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#16263D;fontFamily=Arial;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="58" width="1388" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="How protected links and session changes affect routing" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#435671;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="46" y="108" width="1388" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D3DDEB;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="153" width="1388" height="2" as="geometry" />
        </mxCell>
        <mxCell id="target" value="&lt;b&gt;Protected URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#435671&quot;&gt;signed-out visitor&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="198" width="248" height="68" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;RequireSignIn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#435671&quot;&gt;checks the session&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0ECFE;strokeColor=#BCB1DE;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="331" y="198" width="248" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="target" target="guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="login" value="&lt;b&gt;Login&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#435671&quot;&gt;preserves the next path&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#9CB6E5;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="616" y="198" width="248" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="guard" target="login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="return" value="&lt;b&gt;Return to the destination&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#9CB6E5;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="901" y="198" width="248" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="login" target="return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="access" value="&lt;b&gt;Apply the route guard&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0ECFE;strokeColor=#BCB1DE;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1186" y="198" width="248" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#607B9B;strokeWidth=2;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="return" target="access">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="&lt;b&gt;Return after sign-in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;RequireSignIn&lt;/span&gt; sends visitors on protected URLs to &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;/login?next=&amp;lt;encoded path&amp;gt;&lt;/span&gt;. Login and registration accept only recognised, same-site destinations for &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;next&lt;/span&gt;, such as &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;/events/1/edit&lt;/span&gt;. After sign-in the regular route guards still apply." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="320" width="682" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="&lt;b&gt;Match the event ID&lt;/b&gt;&lt;br&gt;Match &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;/events/new&lt;/span&gt; as a static route. For parameterised routes, validate that &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;eventId&lt;/span&gt; is a positive safe integer before any request. Show an event-not-found state for an invalid ID or an event lookup that returns &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;404&lt;/span&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="320" width="682" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="&lt;b&gt;Check event ownership&lt;/b&gt;&lt;br&gt;On organiser pages, compare the session&amp;#x27;s user ID with &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;organiser_id&lt;/span&gt; from event details. If they differ, show an access-denied state. Also handle a backend &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;403&lt;/span&gt; on attendee requests and edits if access changes after the page loads." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="46" y="480" width="682" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="&lt;b&gt;End the session&lt;/b&gt;&lt;br&gt;Signing out is a navigation action. It clears the session and sends the user to &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;/events&lt;/span&gt;. An expired session on a protected page sends the user to sign-in with the current path as &lt;span style=&quot;font-family:Menlo,monospace;font-size:0.94em&quot;&gt;next&lt;/span&gt;. Event details remain public when a session ends." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DDEB;fontColor=#16263D;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="480" width="682" height="136" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>